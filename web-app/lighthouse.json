{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000",
        "http://localhost:3000/examples",
        "http://localhost:3000/create",
        "http://localhost:3000/auth/signin",
        "http://localhost:3000/auth/signup"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless",
        "preset": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0
        },
        "emulatedFormFactor": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "audits:first-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "audits:largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "audits:cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "audits:time-to-interactive": ["error", { "maxNumericValue": 3800 }],
        "audits:speed-index": ["error", { "maxNumericValue": 3400 }],
        "audits:uses-optimized-images": "error",
        "audits:uses-webp-images": "error",
        "audits:uses-responsive-images": "error",
        "audits:efficient-animated-content": "error",
        "audits:unused-css-rules": "error",
        "audits:unused-javascript": "error",
        "audits:modern-image-formats": "error",
        "audits:offscreen-images": "error",
        "audits:render-blocking-resources": "error",
        "audits:unminified-css": "error",
        "audits:unminified-javascript": "error"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  },
  "extends": "lighthouse:default",
  "settings": {
    "onlyAudits": [
      "first-contentful-paint",
      "largest-contentful-paint",
      "cumulative-layout-shift",
      "time-to-interactive",
      "speed-index",
      "interactive",
      "mainthread-work-breakdown",
      "bootup-time",
      "uses-optimized-images",
      "uses-webp-images",
      "uses-responsive-images",
      "efficient-animated-content",
      "unused-css-rules",
      "unused-javascript",
      "modern-image-formats",
      "offscreen-images",
      "render-blocking-resources",
      "unminified-css",
      "unminified-javascript",
      "server-response-time",
      "redirects",
      "uses-rel-preconnect",
      "uses-rel-preload",
      "font-display",
      "network-requests",
      "network-rtt",
      "network-server-latency",
      "total-byte-weight",
      "dom-size",
      "critical-request-chains",
      "user-timings",
      "screenshot-thumbnails",
      "final-screenshot",
      "metrics"
    ],
    "skipAudits": [
      "canonical",
      "structured-data",
      "robots-txt",
      "hreflang",
      "plugins",
      "charset"
    ],
    "budgets": [
      {
        "path": "/*",
        "timings": [
          {
            "metric": "first-contentful-paint",
            "budget": 1800
          },
          {
            "metric": "largest-contentful-paint",
            "budget": 2500
          },
          {
            "metric": "cumulative-layout-shift",
            "budget": 0.1
          },
          {
            "metric": "time-to-interactive",
            "budget": 3800
          },
          {
            "metric": "speed-index",
            "budget": 3400
          }
        ],
        "resourceSizes": [
          {
            "resourceType": "script",
            "budget": 600
          },
          {
            "resourceType": "stylesheet",
            "budget": 150
          },
          {
            "resourceType": "image",
            "budget": 1000
          },
          {
            "resourceType": "font",
            "budget": 100
          },
          {
            "resourceType": "total",
            "budget": 2000
          }
        ],
        "resourceCounts": [
          {
            "resourceType": "script",
            "budget": 10
          },
          {
            "resourceType": "stylesheet",
            "budget": 5
          },
          {
            "resourceType": "image",
            "budget": 20
          },
          {
            "resourceType": "font",
            "budget": 4
          },
          {
            "resourceType": "total",
            "budget": 50
          }
        ]
      }
    ]
  }
}